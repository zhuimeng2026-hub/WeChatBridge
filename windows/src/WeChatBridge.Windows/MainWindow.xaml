<Window x:Class="WeChatBridge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WeChatBridge.Windows"
        Icon="/WeChatBridge.Windows;component/Assets/AppIcon.png"
        Title="{loc:Loc Key='律档通'}" Height="560" Width="720"
        MinHeight="460" MinWidth="600"
        Background="{StaticResource BackgroundColor}"
        FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <!-- The minimal desktop: one status, one destination, one list. No sidebar,
         no target picker, no multi-app forwarding anywhere on this surface. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title actions -->
        <Grid Grid.Row="0">
            <TextBlock Text="{loc:Loc Key='律档通'}" FontSize="19" FontWeight="SemiBold"
                       Foreground="{StaticResource InkColor}" VerticalAlignment="Center" />
            <Button x:Name="SettingsButton" Content="{loc:Loc Key='设置'}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource SettingsButton}" Click="Settings_Click" />
        </Grid>

        <!-- Runtime status: one line of state, one line of explanation, one action. -->
        <Border Grid.Row="1" Margin="0,20,0,0" Padding="16,14" CornerRadius="12"
                Background="{StaticResource SurfaceColor}"
                BorderBrush="{StaticResource StrokeColor}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusTitle}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource InkColor}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusDetail}" Margin="0,4,0,0" FontSize="12.5"
                               Foreground="{StaticResource InkSecondaryColor}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                        Content="{Binding StatusActionText}" Click="StatusAction_Click"
                        Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding HasStatusAction, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Destination -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="16,12" CornerRadius="12"
                Background="{StaticResource SurfaceColor}"
                BorderBrush="{StaticResource StrokeColor}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Key='保存到'}" FontSize="11.5"
                               Foreground="{StaticResource InkTertiaryColor}" />
                    <TextBlock Text="{Binding VaultDisplay}" Margin="0,2,0,0" FontSize="13"
                               Foreground="{StaticResource InkColor}"
                               ToolTip="{Binding VaultPathDisplay}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                        Content="{loc:Loc Key='打开知识库'}" Click="OpenVault_Click"
                        Style="{StaticResource SettingsButton}"
                        Visibility="{Binding HasVault, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Recent archives -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{loc:Loc Key='最近归档'}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource InkColor}" />
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <TextBlock Text="{Binding RecentEmptyText}" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{StaticResource InkTertiaryColor}"
                           Visibility="{Binding HasRecent, Converter={StaticResource InvertBoolToVisibility}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Recent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Background="{StaticResource SurfaceColor}"
                                        BorderBrush="{StaticResource StrokeSoftColor}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ChatName}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource InkColor}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="330" />
                                                <TextBlock Text="{Binding TimeText}" Margin="10,0,0,0" FontSize="12"
                                                           Foreground="{StaticResource InkTertiaryColor}" />
                                                <TextBlock Text="{Binding StateText}" Margin="10,0,0,0" FontSize="12"
                                                           Foreground="{StaticResource InkSecondaryColor}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Margin="0,3,0,0" FontSize="12"
                                                       Foreground="{StaticResource WarnInkColor}" TextWrapping="Wrap"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Content="{Binding ActionText}" Click="RowAction_Click"
                                                Style="{StaticResource SettingsButton}"
                                                Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
