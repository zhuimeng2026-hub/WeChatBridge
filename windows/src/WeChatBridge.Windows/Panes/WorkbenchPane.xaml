<UserControl x:Class="WeChatBridge.Windows.Panes.WorkbenchPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WeChatBridge.Windows">
    <UserControl.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <DataTemplate x:Key="MaterialTemplate">
            <Grid Margin="2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          VerticalAlignment="Center" Margin="3,0,8,0" />
                <StackPanel Grid.Column="1" Margin="0,2">
                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource InkColor}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding RelativePath}" FontSize="10.5" Foreground="{StaticResource InkTertiaryColor}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AttachmentTemplate">
            <Border Margin="0,2,6,2" Padding="7,4" CornerRadius="6" Background="{StaticResource SunkenColor}">
                <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="{StaticResource InkSecondaryColor}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SourceLinkTemplate">
            <Button Content="{Binding Name}" Tag="{Binding RelativePath}" Padding="6,2" Margin="0,0,6,0"
                    Style="{StaticResource SettingsButton}" FontSize="10.5" Click="SourceLink_Click" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="AssistantHeight" Height="250" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="VaultLabel" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkColor}" />
                <TextBlock x:Name="VaultPath" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource InkTertiaryColor}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource ToolButton}" Margin="0,0,8,0"
                    Click="Refresh_Click" />
            <Button x:Name="ChooseVaultButton" Grid.Column="2" Style="{StaticResource ToolButton}"
                    Click="ChooseVault_Click" />
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SunkenColor}" CornerRadius="10" Padding="10">
                <DockPanel>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,5"
                             TextChanged="Search_TextChanged" />
                    <ListBox x:Name="MaterialsList" BorderThickness="0" Background="Transparent"
                             ItemTemplate="{StaticResource MaterialTemplate}" SelectionChanged="Materials_SelectionChanged" />
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource StrokeSoftColor}"
                    BorderThickness="1" CornerRadius="10" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock x:Name="DocumentTitle" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkColor}" />
                        <TextBlock x:Name="DocumentPath" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource InkTertiaryColor}" />
                    </StackPanel>
                    <ItemsControl x:Name="AttachmentsList" Grid.Row="1" Margin="0,0,0,10" ItemTemplate="{StaticResource AttachmentTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBox x:Name="DocumentBody" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                             Background="Transparent" Foreground="{StaticResource InkColor}"
                             FontSize="13" Padding="0" />
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource SunkenColor}" CornerRadius="10" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="AssistantTitle" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkColor}" />
                        <TextBlock x:Name="AssistantNotice" Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource InkTertiaryColor}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectionCount" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource InkSecondaryColor}" />
                        <Button x:Name="CollapseButton" Margin="10,0,0,0" Style="{StaticResource ToolButton}"
                                Padding="7,3" Click="Collapse_Click" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="AssistantBody" Grid.Row="1" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="PromptBox" Padding="9,7" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" TextChanged="Prompt_TextChanged" />
                        <TextBlock x:Name="PromptHint" Margin="10,8,8,8" Foreground="{StaticResource InkTertiaryColor}"
                                   IsHitTestVisible="False" TextWrapping="Wrap" />
                        <TextBox x:Name="DraftTitleBox" Grid.Row="1" Margin="0,6,0,0" Padding="8,4" />
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBox x:Name="ResultBox" Padding="9,7" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" TextChanged="Result_TextChanged" />
                            <TextBlock x:Name="ResultHint" Margin="10,8,8,8" Foreground="{StaticResource InkTertiaryColor}"
                                       IsHitTestVisible="False" TextWrapping="Wrap" />
                        </Grid>
                        <ItemsControl x:Name="SourceLinks" Grid.Row="1" Margin="0,6,0,0" ItemTemplate="{StaticResource SourceLinkTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Grid>
                <Grid x:Name="AssistantFooter" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="10.5"
                               Foreground="{StaticResource InkTertiaryColor}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,8,0">
                        <TextBlock x:Name="SaveFolderLabel" VerticalAlignment="Center" Margin="0,0,6,0"
                                   FontSize="10.5" Foreground="{StaticResource InkSecondaryColor}" />
                        <TextBox x:Name="SaveFolderBox" Width="86" Padding="6,4" />
                    </StackPanel>
                    <Button x:Name="CopyRequestButton" Grid.Column="2" Style="{StaticResource ToolButton}" Margin="0,0,8,0"
                            Click="CopyRequest_Click" />
                    <Button x:Name="SaveNoteButton" Grid.Column="3" Style="{StaticResource PrimaryButton}"
                            Padding="12,5" MinHeight="30" Click="SaveNote_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
