<UserControl x:Class="WeChatBridge.Windows.Panes.GeneralPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WeChatBridge.Windows">
    <UserControl.Resources>
        <!-- The retention dropdown, drawn like the rest of the settings
             chrome: white rounded face, hairline border, chevron, white popup.
             Scoped here because 通用 is the only pane with a combo. -->
        <Style x:Key="MacCombo" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource InkColor}" />
            <Setter Property="Width" Value="150" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="{StaticResource SurfaceColor}"
                                    BorderBrush="{StaticResource ButtonBorderColor}"
                                    BorderThickness="1" CornerRadius="10" />
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}" />
                                <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{StaticResource InkSecondaryColor}"
                                           Text="▾" />
                            </Grid>
                            <ToggleButton x:Name="DropDownToggle" ClickMode="Press"
                                          Focusable="False" Background="Transparent"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup Placement="Bottom" Focusable="False" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, ElementName=Chrome}"
                                        Background="{StaticResource SurfaceColor}"
                                        BorderBrush="{StaticResource StrokeColor}"
                                        BorderThickness="1" CornerRadius="10"
                                        Margin="0,4,0,0" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" />
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="260" CanContentScroll="False"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource HoverColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="FontSize" Value="12.5" />
                        <Setter Property="Foreground" Value="{StaticResource InkColor}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="row" Margin="1" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}"
                                            Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="row" Property="Background"
                                                    Value="{StaticResource HoverColor}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource BrandColor}" />
                                            <Setter TargetName="row" Property="Background"
                                                    Value="{StaticResource BrandTintColor}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 运行状态 — the one real card: a block, not a settings row. -->
        <StackPanel>
            <TextBlock Style="{StaticResource SectionLabel}" Text="{loc:Loc Key='运行状态'}" />
            <Border Height="1" Background="{StaticResource StrokeColor}" Margin="0,8,0,10" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="{StaticResource InkSecondaryColor}"
                                   TextWrapping="Wrap"
                                   Text="{Binding InboxRoot, StringFormat={loc:Loc Key='Inbox：{0}'}}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                   Foreground="{StaticResource InkSecondaryColor}"
                                   Text="{Binding SummaryText}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                            Style="{StaticResource SettingsButton}" Click="RevealInbox_Click"><Button.Content><loc:Loc Key="打开 Inbox 文件夹"/></Button.Content></Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 授权状态入口：尚未授权/未购买时，一键进入购买流程（购买窗口内含「我已付款」）。
             已授权或便携版时由代码隐藏。直接置于授权状态上方。 -->
        <Button x:Name="OpenActivationButton" Margin="0,24,0,0"
                HorizontalAlignment="Right" Style="{StaticResource SettingsButton}"
                Visibility="Collapsed" Click="OpenActivation_Click">
            <Button.Content><loc:Loc Key="购买授权"/></Button.Content>
        </Button>

        <!-- 已付款入口：与「购买授权」并列。点击即向服务器申请授权码（复用激活请求的 requestId），
             已授权或便携版时由代码隐藏。 -->
        <Button x:Name="OpenPaidButton" Margin="0,8,0,0"
                HorizontalAlignment="Right" Style="{StaticResource SettingsButton}"
                Visibility="Collapsed" Click="OpenPaid_Click">
            <Button.Content><loc:Loc Key="我已付款"/></Button.Content>
        </Button>

        <!-- 授权状态。Always visible, and never a blocker: forwarding works for every
             installation, licensed or not. This is the standing place to see where the
             licence stands and to reopen the page after deciding not to buy the first
             time it appeared. -->
        <StackPanel Margin="0,12,0,0">
            <TextBlock Style="{StaticResource SectionLabel}" Text="{loc:Loc Key='授权状态'}" />
            <Border Height="1" Background="{StaticResource StrokeColor}" Margin="0,8,0,10" />
            <Border Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 微信头像。The letter block is underneath from the start, not
                         swapped in on failure: WPF's Image draws nothing at all when a
                         download fails, so the initial is what shows, and there is no
                         broken-image glyph to suppress. Collapsed until RenderLicenceState
                         finds a usable account, because an avatar with nobody to
                         attribute it to is worse than no avatar. -->
                    <Grid x:Name="AvatarContainer" Width="32" Height="32"
                          Margin="0,0,10,0" VerticalAlignment="Center"
                          Visibility="Collapsed">
                        <Border CornerRadius="16" Background="{StaticResource BrandSoftColor}">
                            <TextBlock x:Name="AvatarFallback" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" />
                        </Border>
                        <Image x:Name="AvatarImage" Width="32" Height="32">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,32,32" RadiusX="16" RadiusY="16" />
                            </Image.Clip>
                        </Image>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LicenceStatusText" FontSize="13"
                                   Foreground="{StaticResource InkSecondaryColor}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="MachineCodeHint" Margin="0,4,0,0" FontSize="12"
                                   Foreground="{StaticResource InkTertiaryColor}"
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                        <!-- 仅在 MeAsync 成功后出现："会话：演示买家 · 上次活跃 2 小时前"。
                             失败 / 未登录 / 网络挂 都保持 Collapsed，不打扰用户。 -->
                        <TextBlock x:Name="SessionInfoText" Margin="0,4,0,0" FontSize="12"
                                   Foreground="{StaticResource InkTertiaryColor}"
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 应用行为 -->
        <StackPanel Margin="0,24,0,0">
            <TextBlock Style="{StaticResource SectionLabel}" Text="{loc:Loc Key='应用行为'}" />
            <Border Height="1" Background="{StaticResource StrokeColor}" Margin="0,8,0,10" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="13.5" Foreground="{StaticResource InkColor}"
                               Text="{loc:Loc Key='开机自动启动'}" />
                    <TextBlock Margin="0,3,0,0" FontSize="12"
                               Foreground="{StaticResource InkSecondaryColor}" TextWrapping="Wrap"
                               Text="{Binding AutoStartHint}" />
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                          Style="{StaticResource MacToggle}"
                          IsEnabled="{Binding AutoStartAvailable}"
                          IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}" />
            </Grid>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="13.5" Foreground="{StaticResource InkColor}"
                               Text="{loc:Loc Key='记录保留时间'}" />
                    <TextBlock Margin="0,3,0,0" FontSize="12"
                               Foreground="{StaticResource InkSecondaryColor}" TextWrapping="Wrap"
                               Text="{loc:Loc Key='到期的记录会移入回收站；回收站里的内容仍可以恢复。'}" />
                </StackPanel>
                <ComboBox Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                          Style="{StaticResource MacCombo}"
                          SelectedIndex="{Binding RetentionIndex, Mode=TwoWay}">
                    <ComboBoxItem><ComboBoxItem.Content><loc:Loc Key="永久保留"/></ComboBoxItem.Content></ComboBoxItem>
                    <ComboBoxItem><ComboBoxItem.Content><loc:Loc Key="保留 7 天"/></ComboBoxItem.Content></ComboBoxItem>
                    <ComboBoxItem><ComboBoxItem.Content><loc:Loc Key="保留 30 天"/></ComboBoxItem.Content></ComboBoxItem>
                </ComboBox>
            </Grid>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="13.5" Foreground="{StaticResource InkColor}"
                               Text="{loc:Loc Key='自动导入 WorkBuddy 聊天包'}" />
                    <TextBlock Margin="0,3,0,0" FontSize="12"
                               Foreground="{StaticResource InkSecondaryColor}" TextWrapping="Wrap"
                               Text="{loc:Loc Key='只监视 WorkBuddy 的本机聊天记录导出目录；新 ZIP 写完后自动出现在记录中，不会自动发送。'}" />
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                          Style="{StaticResource MacToggle}"
                          IsChecked="{Binding WorkBuddyAutoImport, Mode=TwoWay}" />
            </Grid>
        </StackPanel>

        <DockPanel Margin="0,20,0,0">
            <ComboBox DockPanel.Dock="Right" Width="150" Style="{StaticResource MacCombo}" SelectedIndex="{Binding LanguageIndex}">
                <ComboBoxItem Content="{loc:Loc Key='跟随系统'}"/><ComboBoxItem Content="{loc:Loc Key='简体中文'}"/><ComboBoxItem Content="English"/>
            </ComboBox>
            <TextBlock Text="{loc:Loc Key='界面语言（重启后生效）'}" Foreground="{StaticResource InkColor}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 软件与帮助 -->
        <StackPanel Margin="0,24,0,0">
            <TextBlock Style="{StaticResource SectionLabel}" Text="{loc:Loc Key='软件与帮助'}" />
            <Border Height="1" Background="{StaticResource StrokeColor}" Margin="0,8,0,10" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="13.5" Foreground="{StaticResource InkColor}"
                               Text="{loc:Loc Key='当前版本'}" />
                    <TextBlock x:Name="VersionText" Margin="0,3,0,0" FontSize="12"
                               Foreground="{StaticResource InkSecondaryColor}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                        Style="{StaticResource SettingsButton}" Click="OpenProject_Click"><Button.Content><loc:Loc Key="访问项目"/></Button.Content></Button>
            </Grid>
            <Border Height="1" Background="{StaticResource StrokeSoftColor}" Margin="0,14" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="13.5" Foreground="{StaticResource InkColor}"
                               Text="{loc:Loc Key='重新运行设置向导'}" />
                    <TextBlock Margin="0,3,0,0" FontSize="12"
                               Foreground="{StaticResource InkSecondaryColor}" TextWrapping="Wrap"
                               Text="{loc:Loc Key='再走一遍欢迎、入口和驻留说明，不改动已设置的偏好。'}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                        Style="{StaticResource SettingsButton}" Click="RestartOnboarding_Click"><Button.Content><loc:Loc Key="重新运行"/></Button.Content></Button>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
