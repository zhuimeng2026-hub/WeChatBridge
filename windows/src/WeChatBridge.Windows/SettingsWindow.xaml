<Window x:Class="WeChatBridge.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WeChatBridge.Windows"
        Title="{loc:Loc Key='设置'}" Width="520" Height="600"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundColor}"
        FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key='设置'}" FontSize="19" FontWeight="SemiBold"
                           Foreground="{StaticResource InkColor}" />

                <!-- Destination -->
                <TextBlock Text="{loc:Loc Key='Obsidian 知识库'}" Margin="0,20,0,6" FontSize="12.5"
                           Foreground="{StaticResource InkSecondaryColor}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="VaultBox" Grid.Column="0" Padding="8,6" FontSize="12.5"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="{loc:Loc Key='浏览…'}"
                            Style="{StaticResource SettingsButton}" Click="Browse_Click" />
                </Grid>
                <TextBlock x:Name="VaultError" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource DangerColor}" Visibility="Collapsed" />

                <TextBlock Text="{loc:Loc Key='保存文件夹'}" Margin="0,16,0,6" FontSize="12.5"
                           Foreground="{StaticResource InkSecondaryColor}" />
                <TextBox x:Name="SubfolderBox" Padding="8,6" FontSize="12.5"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="{loc:Loc Key='仅允许知识库内的相对路径，不能使用绝对路径或 ..。'}"
                           Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{StaticResource InkTertiaryColor}" />
                <TextBlock x:Name="SubfolderError" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource DangerColor}" Visibility="Collapsed" />

                <CheckBox x:Name="LaunchBox" Margin="0,20,0,0" Content="{loc:Loc Key='开机启动'}"
                          FontSize="12.5" Foreground="{StaticResource InkColor}" />
                <CheckBox x:Name="NotifyBox" Margin="0,10,0,0" Content="{loc:Loc Key='归档完成通知'}"
                          FontSize="12.5" Foreground="{StaticResource InkColor}" />

                <!-- Source repair: only needed when detection is unhealthy. -->
                <Separator Margin="0,20,0,0" />
                <TextBlock Text="{loc:Loc Key='接收目录'}" Margin="0,16,0,6" FontSize="12.5"
                           Foreground="{StaticResource InkSecondaryColor}" />
                <TextBlock x:Name="SourcePathText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource InkColor}" />
                <TextBlock x:Name="SourceStateText" Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{StaticResource InkTertiaryColor}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{loc:Loc Key='重新检测'}" Style="{StaticResource SettingsButton}"
                            Click="Recheck_Click" />
                    <Button Content="{loc:Loc Key='手动指定目录'}" Margin="8,0,0,0"
                            Style="{StaticResource SettingsButton}" Click="ManualSource_Click" />
                    <Button Content="{loc:Loc Key='恢复自动检测'}" Margin="8,0,0,0"
                            Style="{StaticResource SettingsButton}" Click="ResetSource_Click" />
                </StackPanel>

                <!-- Diagnostics: the log is the evidence, and the user has to
                     be able to reach it without knowing where it is. -->
                <Separator Margin="0,20,0,0" />
                <TextBlock Text="{loc:Loc Key='诊断日志'}" Margin="0,16,0,6" FontSize="12.5"
                           Foreground="{StaticResource InkSecondaryColor}" />
                <TextBlock x:Name="LogPathText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource InkColor}" />
                <TextBlock x:Name="LogHintText" Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{StaticResource InkTertiaryColor}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{loc:Loc Key='导出诊断日志'}" Style="{StaticResource SettingsButton}"
                            Click="ExportLog_Click" />
                    <Button Content="{loc:Loc Key='打开日志目录'}" Margin="8,0,0,0"
                            Style="{StaticResource SettingsButton}" Click="OpenLogFolder_Click" />
                </StackPanel>

                <TextBlock x:Name="VersionText" Margin="0,22,0,0" FontSize="11.5"
                           Foreground="{StaticResource InkTertiaryColor}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc Key='取消'}" MinWidth="80"
                    Style="{StaticResource SettingsButton}" Click="Cancel_Click" />
            <Button Content="{loc:Loc Key='保存'}" MinWidth="80" Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
