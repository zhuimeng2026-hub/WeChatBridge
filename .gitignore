# Swift / SwiftPM
.build/
.swiftpm/

# Build output
dist/

# Xcode, if anyone opens the package there
*.xcodeproj
*.xcworkspace
xcuserdata/
DerivedData/
*.xcresult

# Working notes: design records, implementation plans, field measurements and
# the research behind the WeChat automation. They read as the diary of one Mac
# and one WeChat build rather than as documentation, so they stay local.
/DUKOU_MACOS_IMPLEMENTATION_RESEARCH.md

# One-off probes used to recover WeChat's export behaviour. The verified
# implementation lives in macos/Sources/ and macos/Tests/; shipping these would
# ship a second, unmaintained automation client beside the app.
/macos/Scripts/wechat-*
/macos/Scripts/verify-wechat-export.py

# macOS
.DS_Store
._*

# Local diagnostics
*.log

# Editors
.vscode/
.idea/
*.swp

# Signing material, should it ever be generated locally
*.p12
*.pfx
*.pem
*.key
*.cer
*.p8

# A local run of the licence server: its generated issuing key, its config and
# the public key that key implies. Whole-directory rather than per-file because
# anything dropped in here to make `go run ./cmd/wcb` work is by definition
# something that must not reach the repository — and the private key in
# particular must never be committed, here or anywhere else.
/server/.local/

# `go build ./...` inside server/ writes the cmd/wcb executable to the current
# directory, so the documented build command drops a 25 MB binary next to the
# source. It is regenerated by the next build and must never be committed.
/server/wcb

# Local environment files
.env
.env.*
!.env.example

# Local design exploration output
output/

# Windows/.NET build output and local packaging artifacts
windows/**/bin/
windows/**/obj/
windows/artifacts/
windows/**/*.msix
windows/**/*.appx

# Local agent workspace and private session context
AGENTS.md
IDENTITY.md
IDENTITY_CONFIRMATION.md
WeChatBridge.identity.json
MEMORY.md
memory/
.cowork-temp/

# Python byte-code from local scripts
__pycache__/
*.pyc

# Local agent workspace: verification probes, scratch notes and one-off commit
# messages. These are working artifacts for this machine only and must never
# reach the repository (the probe scripts in particular are unmaintained side
# channels beside the real implementation).
/.artifacts/

# Exported public-key reference file (P-256 SPKI for the licence verifier).
# It is a build input reference, not source — keep it local.
/pubkey.txt

# The seller's payment QR codes, kept on the machine that deploys the service.
# These are money-receiving codes: they belong to the server's
# WCB_PAYMENT_CODE_PATH / WCB_CONTACT_QR_PATH configuration, never in the
# repository — a commit here would publish a live collection code.
/paypic/
